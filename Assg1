import nltk
import spacy

from nltk.corpus import stopwords
from nltk.stem import PorterStemmer, WordNetLemmatizer
from nltk import pos_tag, word_tokenize

nltk.download('punkt_tab', quiet=True)
nltk.download('stopwords', quiet=True)
nltk.download('wordnet', quiet=True)
nltk.download('averaged_perceptron_tagger_eng', quiet=True)

nlp = spacy.load("en_core_web_sm")

text = "The boys are playing cricket and running fast."

# Tokenization
words = word_tokenize(text.lower())
print("Tokens:", words)

# Stop word removal
stop = set(stopwords.words('english'))
filtered = [w for w in words if w.isalpha() and w not in stop]
print("Filtered:", filtered)

# Stemming
ps = PorterStemmer()
print("Stemming:", [ps.stem(w) for w in filtered])

# Lemmatization
lm = WordNetLemmatizer()
print("Lemmatization:", [lm.lemmatize(w) for w in filtered])

# POS tagging
print("POS Tagging:", pos_tag(words))

# spaCy processing
doc = nlp(text)
print("spaCy Tokens:", [t.text for t in doc])
print("spaCy POS:", [(t.text, t.pos_) for t in doc])

print("NLP preprocessing completed")

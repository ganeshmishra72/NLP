import spacy
from spacy import displacy

# Load model
nlp = spacy.load("en_core_web_sm")

# Input text
text = "Apple hired John in London in 2025."

# Perform NER
doc = nlp(text)

print("Named Entities:")

for ent in doc.ents:
    print(ent.text, ent.label_)

# Visualize entities
displacy.serve(doc, style="ent")
